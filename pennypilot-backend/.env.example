# Supabase Database Configuration Example:
# DB_HOST=db.<project-ref>.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=your_supabase_password

# Or full JDBC URL for Supabase:
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require

DB_HOST=localhost
DB_PORT=5432
DB_NAME=pennypilot
DB_USERNAME=pennypilot
DB_PASSWORD=pennypilot

# Server Configuration
SERVER_PORT=8080

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
